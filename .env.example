# ---- apps/api: core ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://amar:amar@localhost:5432/amar_poribar
# Production: at least 32 random characters, not containing "change-me".
JWT_SECRET=change-me
# Production: at least 32 random characters. Keys the hashes in identity.otp_challenges.
OTP_PEPPER=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=
# api | worker | all
ROLE=all
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Bearer token protecting /metrics (optional).
METRICS_TOKEN=
# Comma list of flag=on|off, e.g. voice_notes=on,video_calls=off
FEATURE_FLAGS=

# ---- apps/api: AI ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- apps/api: SMS (fake | sslwireless | alphasms; production must not be fake) ----
SMS_GATEWAY=fake
SMS_API_KEY=
SMS_SENDER_ID=

# Base URL of tools/fakes (used when SMS_GATEWAY=fake / PUSH_PROVIDER=fake).
FAKES_URL=http://localhost:4100

# ---- apps/api: push (fake | fcm) ----
PUSH_PROVIDER=fake
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ---- apps/api: object storage (defaults target local MinIO) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=amar
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# ---- apps/api: TURN for video calls ----
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=3600

# ---- apps/api: payments (fake | real; real requires every key below) ----
PAYMENT_PROVIDER=fake
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=

# ---- apps/web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
