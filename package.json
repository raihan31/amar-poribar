{
  "name": "amar-poribar",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/check-ci-jobs.test.mjs",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down -v",
    "e2e:web": "pnpm --filter @amar-poribar/web e2e",
    "e2e:admin": "pnpm --filter @amar-poribar/admin e2e",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter @amar-poribar/api db:generate",
    "db:migrate": "pnpm --filter @amar-poribar/api db:migrate",
    "db:reset": "pnpm --filter @amar-poribar/api db:reset",
    "db:check": "pnpm --filter @amar-poribar/api db:check",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "mobile:test": "cd apps/mobile && flutter test",
    "mobile:verify:m0": "cd apps/mobile && tool/verify.sh M0",
    "mobile:verify:m1": "cd apps/mobile && tool/verify.sh M1",
    "mobile:verify:m2": "cd apps/mobile && tool/verify.sh M2",
    "mobile:verify:m3": "cd apps/mobile && tool/verify.sh M3",
    "mobile:verify:m4": "cd apps/mobile && tool/verify.sh M4",
    "mobile:verify:m5": "cd apps/mobile && tool/verify.sh M5",
    "mobile:verify:m6": "cd apps/mobile && tool/verify.sh M6",
    "mobile:verify:m7": "cd apps/mobile && tool/verify.sh M7",
    "mobile:verify:m8": "cd apps/mobile && tool/verify.sh M8",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise apps/api/src --config .dependency-cruiser.cjs && pnpm --filter @amar-poribar/api exec vitest run src/architecture.test.ts",
    "openapi:check": "turbo run build --filter=@amar-poribar/api^... && pnpm --filter @amar-poribar/api openapi:build -- --check",
    "test:db": "turbo run test:db --filter=@amar-poribar/api --concurrency=1",
    "seed:dev": "pnpm --filter @amar-poribar/api exec tsx scripts/seed-dev.ts",
    "gen:module": "node tools/gen-module.mjs",
    "arch:negative": "node tools/arch-negative.mjs",
    "i18n:check": "node tools/i18n-keys.mjs",
    "docs:check": "node tools/check-docs.mjs",
    "no-drizzle-push": "! grep -rn 'drizzle-kit push' docker-compose.yml Dockerfile .github/workflows",
    "coverage": "pnpm --filter @amar-poribar/shared coverage && pnpm --filter @amar-poribar/ai coverage && pnpm --filter @amar-poribar/api coverage",
    "verify:web": "pnpm --filter @amar-poribar/web gen:api:check && pnpm --filter @amar-poribar/web lint && pnpm --filter @amar-poribar/web typecheck && pnpm --filter @amar-poribar/web test --run && pnpm --filter @amar-poribar/web build && pnpm --filter @amar-poribar/web e2e:mock",
    "verify:admin": "pnpm --filter @amar-poribar/admin gen:api:check && pnpm --filter @amar-poribar/admin lint && pnpm --filter @amar-poribar/admin typecheck && pnpm --filter @amar-poribar/admin test --run && pnpm --filter @amar-poribar/admin build && pnpm --filter @amar-poribar/admin e2e:mock",
    "verify:m0": "node tools/verify.mjs m0",
    "verify:m1": "node tools/verify.mjs m1",
    "verify:m2": "node tools/verify.mjs m2",
    "verify:m3": "node tools/verify.mjs m3",
    "verify:m4": "node tools/verify.mjs m4",
    "verify:m5": "node tools/verify.mjs m5",
    "verify:m6": "node tools/verify.mjs m6",
    "verify:m7": "node tools/verify.mjs m7",
    "verify:m8": "node tools/verify.mjs m8"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2"
  }
}
