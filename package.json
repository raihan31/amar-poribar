{
  "name": "amar-poribar",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d db",
    "db:push": "pnpm --filter @amar-poribar/api db:push",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "mobile:test": "cd apps/mobile && flutter test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "echo 'added in T-PLAT-03' && exit 0",
    "openapi:check": "echo 'added in T-PLAT-14' && exit 0",
    "test:db": "echo 'added in T-PLAT-19' && exit 0",
    "gen:module": "node tools/gen-module.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2"
  }
}
