# Committed defaults for `docker compose up`. No secrets: everything here is dev-only.
# Production refuses the JWT default below (it contains "change-me").
NODE_ENV=${API_NODE_ENV:-development}
PORT=4000
WORKER_PORT=4001
DATABASE_URL=postgres://amar:amar@db:5432/amar_poribar
JWT_SECRET=${JWT_SECRET:-dev-only-secret-change-me-0123456789abcdef}
OTP_PEPPER=${OTP_PEPPER:-dev-only-otp-pepper-0123456789abcdef0123}
CORS_ORIGIN=${CORS_ORIGIN:-http://localhost:3000,http://localhost:3100}
LOG_LEVEL=info
SMS_GATEWAY=fake
PUSH_PROVIDER=fake
PAYMENT_PROVIDER=fake
FAKES_URL=http://fakes:4100
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=amar
STORAGE_ACCESS_KEY=amar
STORAGE_SECRET_KEY=amarsecret
STORAGE_REGION=us-east-1
TURN_URLS=turn:localhost:3478
TURN_SECRET=${TURN_SECRET:-dev-only-turn-secret}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
AI_MODEL=${AI_MODEL:-}
