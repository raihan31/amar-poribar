{
  "name": "@amar-poribar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:db": "vitest run --project db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/platform/migrate-cli.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env src/platform/reset-cli.ts",
    "openapi:build": "tsx scripts/build-openapi.ts",
    "db:check": "node scripts/check-migrations.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@amar-poribar/ai": "workspace:*",
    "@amar-poribar/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/websocket": "^11.3.7",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg-boss": "^10.4.2",
    "pino": "^10.4.0",
    "postgres": "^3.4.0",
    "prom-client": "^15.1.3",
    "ws": "^8.22.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@amar-poribar/fixtures": "workspace:*",
    "@amar-poribar/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.0"
  }
}
