{
  "name": "@amar-poribar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@amar-poribar/ai": "workspace:*",
    "@amar-poribar/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.0",
    "postgres": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@amar-poribar/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.0"
  }
}
